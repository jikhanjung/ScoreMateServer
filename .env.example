DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# DB: 비워 두면 SQLite ($DATA_DIR/db.sqlite3, 기본 backend/data). 아래는 docker-compose 의 Postgres 용
# DATA_DIR=/data
DATABASE_URL=postgres://scoremate:pass@db:5432/scoremate
# 비워 두면 Celery 작업을 요청 안에서 바로 실행한다 (워커 · Redis 불필요)
REDIS_URL=redis://cache:6379/0

STORAGE_ENDPOINT=http://storage:9000
STORAGE_BUCKET=scores
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=False

JWT_SIGNING_KEY=your_jwt_signing_key_here

MAX_UPLOAD_MB=200
ALLOWED_MIME=application/pdf
REFERRAL_BONUS_MB=50
